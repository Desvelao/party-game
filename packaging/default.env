# Environment of the party-game service (systemd EnvironmentFile: NAME=value, one per line, no quotes needed).
# Everything is optional. Settings in /etc/party-game/config.yaml override these.
# After a change: sudo systemctl restart party-game
#PORT=8080
#HOST=0.0.0.0
#PROFILE=NORMAL
#ADMIN_TOKEN=
#PROFILE_STORE=json

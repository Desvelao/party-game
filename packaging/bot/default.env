# Environment of the party-game-bot service (systemd EnvironmentFile: NAME=value, one per line, no quotes needed).
# Settings in /etc/party-game/bot-server.yaml override these. Every key: /usr/share/doc/party-game-bot/config.example.yaml
# After a change: sudo systemctl restart party-game-bot
#
# Required: the password of the dashboard and the API. Without it the bot server refuses to start.
#ADMIN_TOKEN=
# The game server to serve and, for rooms whose host asked for bots, that server's BOTS_TOKEN.
#GAME_SERVER_URL=http://localhost:8080
#GAME_SERVER_BOT_TOKEN=
#BOT_HOST=127.0.0.1
#BOT_PORT=8090
#BOT_LEVEL=normal
#BOT_MAX_BOTS=8
